{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --frozen --project \"$(git rev-parse --show-toplevel)\" studykit hook pre-git",
            "statusMessage": "studykit pre-git guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --frozen --project \"$(git rev-parse --show-toplevel)\" studykit lint --hook",
            "statusMessage": "studykit lint"
          }
        ]
      }
    ]
  }
}
