{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "SourcePages": {
      "additionalProperties": false,
      "properties": {
        "doc": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Doc",
          "type": "string"
        },
        "pages": {
          "anyOf": [
            {
              "pattern": "^[0-9]+(?:-[0-9]+)?$",
              "type": "string"
            },
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pages"
        }
      },
      "required": [
        "doc"
      ],
      "title": "SourcePages",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Frontmatter of `summary/NN-<topic>.md`.",
  "properties": {
    "topic": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Topic",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "pattern": "^[^\\n]*\\S[^\\n]*$",
      "title": "Title",
      "type": "string"
    },
    "objectives": {
      "default": [],
      "items": {
        "minLength": 1,
        "pattern": "^[^\\n]*\\S[^\\n]*$",
        "type": "string"
      },
      "title": "Objectives",
      "type": "array"
    },
    "sources": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SourcePages"
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "topic",
    "title"
  ],
  "title": "Summary",
  "type": "object"
}
