{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Frontmatter of a practice bank `mc/<topic>.md`.",
  "properties": {
    "topic": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Topic",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "pattern": "^[^\\n]*\\S[^\\n]*$",
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "topic",
    "title"
  ],
  "title": "McBank",
  "type": "object"
}
