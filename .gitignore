# macOS
.DS_Store

# Course data stays local: this repository is public
/courses/*
!/courses/README.md

# Local toolchain and caches
/.tools
/.venv/
/.cache/
node_modules/
__pycache__/

# Build outputs
/site/dist/
/site/.astro/
**/_build/

# Claude Code local state
.claude/settings.local.json
.claude/agent-memory*/
.claude/worktrees/

# Codex local state: the project layer below is tracked (docs/architecture.md §5.5)
/.codex/*
!/.codex/agents/
!/.codex/config.toml
!/.codex/hooks.json
!/.codex/rules/
