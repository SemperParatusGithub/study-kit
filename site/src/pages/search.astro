---
// Full-text search over course content with Pagefind (docs/architecture.md §3.5). The index
// is written by `pagefind --site dist` after the build (scripts/pagefind.mjs); `just dev`
// serves the last built copy from public/pagefind/. Filter values are identifiers; the
// filter pane shows them by name (course and topic titles, type labels).
import Base from '../layouts/Base.astro';
import { listCourses } from '../lib/courses';
import { SEARCH_TYPE } from '../lib/format';

const courses = await listCourses();
const filterNames = {
  course: Object.fromEntries(courses.map((c) => [c.id, c.title])),
  type: SEARCH_TYPE,
  topic: Object.fromEntries(courses.flatMap((c) => c.topics.map((t) => [t.id, t.title]))),
};
---

<Base title="Search" description="Search all courses">
  <div class="search-page">
    <div class="page-head">
      <h1>Search</h1>
      <p class="muted">
        Summaries, exercises, MC questions, exams and cheat sheets of every course. Solutions and
        answer keys are never indexed.
      </p>
    </div>

    <div class="search-ui">
      <pagefind-config bundle-path="/pagefind/"></pagefind-config>
      <script
        type="application/json"
        id="filter-names"
        set:html={JSON.stringify(filterNames).replace(/</g, '\\u003c')}
      />
      <pagefind-input placeholder="Search course content" autofocus></pagefind-input>
      <div class="search-cols">
        <aside class="search-filters" aria-label="Filters">
          <pagefind-filter-pane open></pagefind-filter-pane>
        </aside>
        <div class="search-results">
          <pagefind-summary></pagefind-summary>
          <pagefind-results></pagefind-results>
        </div>
      </div>
    </div>
    <p class="notice notice-warn" data-search-missing hidden>
      The search index is not built yet. Run <code>just build</code> once; <code>just dev</code> then
      serves the last index.
    </p>
    <noscript><p class="notice">Search needs JavaScript.</p></noscript>
  </div>

  <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
  <script is:inline src="/pagefind/pagefind-component-ui.js" defer></script>
  <script>
    type FilterNames = Record<string, Record<string, string>>;

    /** Show filter values (ids) by name; the pane re-renders, so keep watching it. */
    function nameFilters(): void {
      const pane = document.querySelector('pagefind-filter-pane');
      const json = document.getElementById('filter-names')?.textContent;
      if (!pane || !json) return;
      const names = JSON.parse(json) as FilterNames;
      const apply = () => {
        for (const input of pane.querySelectorAll<HTMLInputElement>('input[type="checkbox"][name]')) {
          const name = names[input.name]?.[input.value];
          const text = input.nextSibling;
          if (name && text?.nodeType === Node.TEXT_NODE && text.textContent === input.value) text.textContent = name;
        }
      };
      new MutationObserver(apply).observe(pane, { childList: true, subtree: true });
      apply();
    }

    // Run the query from the header search box (?q=…) once the Pagefind input is ready.
    function start(): void {
      const q = new URLSearchParams(location.search).get('q');
      const missing = document.querySelector<HTMLElement>('[data-search-missing]');
      if (!('PagefindComponents' in window)) {
        if (missing) missing.hidden = false;
        return;
      }
      nameFilters();
      if (!q) return;
      let tries = 0;
      const timer = setInterval(() => {
        const input = document.querySelector<HTMLInputElement>('pagefind-input input');
        if (input || ++tries > 50) clearInterval(timer);
        if (!input) return;
        input.value = q;
        input.dispatchEvent(new Event('input', { bubbles: true }));
      }, 50);
    }
    if (document.readyState === 'complete') start();
    else addEventListener('load', start);
  </script>
</Base>

<style>
  .search-page {
    max-width: 60rem;
    margin-inline: auto;
  }

  .search-ui {
    --pf-text: var(--text);
    --pf-text-secondary: var(--text-muted);
    --pf-text-muted: var(--text-muted);
    --pf-background: var(--surface);
    --pf-border: var(--border);
    --pf-border-focus: var(--accent);
    --pf-hover: var(--surface-2);
    --pf-skeleton: var(--surface-2);
    --pf-skeleton-shine: var(--border);
    --pf-mark: var(--text);
    --pf-font: var(--font-sans);
    --pf-outline-focus: var(--focus);
    --pf-border-radius: var(--radius-sm);
    --pf-input-height: 42px;
    --pf-summary-font-size: var(--text-sm);
    --pf-result-title-font-size: 1rem;
    --pf-result-excerpt-font-size: var(--text-sm);
  }

  .search-cols {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: var(--space-5);
    margin-top: var(--space-4);
  }

  @media (max-width: 44rem) {
    .search-cols {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
