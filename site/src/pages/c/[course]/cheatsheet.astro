---
// Cheat sheet in CSS columns, with the page count of the built PDF against its limit
// (min(3, course.cheatsheet.max_pages, frontmatter max_pages), docs/architecture.md §3.3):
// both come from _build/pdf/manifest.json once the PDF is built.
import Base from '../../../layouts/Base.astro';
import Html from '../../../components/Html.astro';
import PdfLink from '../../../components/PdfLink.astro';
import SearchTags from '../../../components/SearchTags.astro';
import { coursePaths, type Course } from '../../../lib/courses';
import { sectionize } from '../../../lib/html';
import { densityPt, findPdf } from '../../../lib/pdf';
import type { CheatsheetFm } from '../../../lib/types';

export const getStaticPaths = coursePaths;

const { course } = Astro.props as { course: Course };
const c = course.id;
const en = course.lang === 'en' ? undefined : 'en';
const doc = course.cheatsheet;
const fm = (doc?.data.fm ?? {}) as Partial<CheatsheetFm>;
const pdf = doc ? findPdf(course.pdfs, 'cheatsheet') : null;
const max = pdf?.maxPages ?? Math.min(3, course.data.cheatsheet.max_pages, fm.max_pages ?? 3);
const over = pdf !== null && pdf.pages > max;
const pt = densityPt(pdf?.density);
---

<Base title={doc?.data.title ?? 'Cheat sheet'} course={course} tab="cheatsheet">
  <div class="page-head cs-head">
    <div>
      <p class="eyebrow" lang={en}>Cheat sheet</p>
      <h1>{doc?.data.title ?? 'Cheat sheet'}</h1>
    </div>
    {
      doc && (
        <div class="cs-badges" lang={en}>
          {pdf === null ? (
            <span class="badge" data-sk-pdf-pages data-max={max} title={`Build it with: just pdf ${c}`}>
              PDF not built yet · limit {max} {max === 1 ? 'page' : 'pages'}
            </span>
          ) : (
            <>
              <PdfLink course={course} doc={pdf} pages={false} />
              <span
                class:list={['badge', over ? 'badge-warn' : 'badge-accent']}
                data-sk-pdf-pages
                data-max={max}
                data-pages={pdf.pages}
                data-density={pdf.density ?? undefined}
                title={pt ? `Set in ${pt} pt (density ${pdf.density} of 0–4)` : undefined}
              >
                {pdf.pages} / {max} {max === 1 ? 'page' : 'pages'}
                {over && ' · over the limit'}
              </span>
            </>
          )}
        </div>
      )
    }
  </div>

  {
    doc ? (
      <div class="cheatsheet" data-pagefind-body>
        <SearchTags course={course} type="cheatsheet" />
        <span data-pagefind-meta="title[data-value]" data-value={doc.data.title} />
        <Html html={sectionize(doc.rendered?.html ?? '', 'cs-section')} course={c} />
      </div>
    ) : (
      <div class="empty" lang={en}>
        {course.data.cheatsheet.allowed
          ? 'No cheat sheet yet.'
          : 'This exam allows no cheat sheet, so the course has none.'}
      </div>
    )
  }
</Base>

<style>
  .cs-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .cs-head h1 {
    margin-bottom: 0;
  }

  .cs-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
  }

  .cheatsheet {
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  @media (max-width: 30rem) {
    .cheatsheet {
      padding: var(--space-4);
    }
  }
</style>
