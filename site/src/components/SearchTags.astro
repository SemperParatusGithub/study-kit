---
// Pagefind filters and metadata for the content element this sits in (docs/architecture.md
// §3.5). Filter values are identifiers (course id, type, topic id); the /search page shows
// them by name. Values come from attributes, so nothing here is indexed as text.
import type { Course } from '../lib/courses';
import type { SearchType } from '../lib/format';

interface Props {
  course: Course;
  type: SearchType;
  topic?: string | null;
  difficulty?: number | null;
}

const { course, type, topic, difficulty } = Astro.props;
---

<span data-pagefind-filter="course[data-value]" data-value={course.id}></span>
<span data-pagefind-filter="type[data-value]" data-value={type}></span>
{topic && <span data-pagefind-filter="topic[data-value]" data-value={topic} />}
<span data-pagefind-meta="course[data-value]" data-value={course.title}></span>
{difficulty ? <span data-pagefind-meta="difficulty[data-value]" data-value={String(difficulty)} /> : null}
