---
// Pagefind filters and metadata for the content element this sits in (docs/architecture.md
// §3.5). Values come from attributes, so titles with commas stay one value and nothing here
// is indexed as text.
import type { Course } from '../lib/courses';

export type SearchType = 'overview' | 'summary' | 'exercise' | 'mc' | 'exam' | 'cheatsheet';

interface Props {
  course: Course;
  type: SearchType;
  topic?: string | null;
  difficulty?: number | null;
}

const { course, type, topic, difficulty } = Astro.props;
const LABEL: Record<SearchType, string> = {
  overview: 'Overview',
  summary: 'Summary',
  exercise: 'Exercise',
  mc: 'MC question',
  exam: 'Mock exam',
  cheatsheet: 'Cheat sheet',
};
---

<span data-pagefind-filter="course[data-value]" data-value={course.title}></span>
<span data-pagefind-filter="type[data-value]" data-value={LABEL[type]}></span>
{topic && <span data-pagefind-filter="topic[data-value]" data-value={course.topicTitle(topic)} />}
<span data-pagefind-meta="course[data-value]" data-value={course.title}></span>
{difficulty ? <span data-pagefind-meta="difficulty[data-value]" data-value={String(difficulty)} /> : null}
