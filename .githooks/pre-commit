#!/bin/sh
# Keep course material and generated course content out of this public repository.
set -eu

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

bad_courses=$(printf '%s\n' "$staged" | grep -E '^courses/' | grep -vx 'courses/README.md' || true)
if [ -n "$bad_courses" ]; then
  echo "pre-commit: course data must never be committed (courses/ is local only):" >&2
  printf '  %s\n' $bad_courses >&2
  echo "unstage with: git restore --staged <path>" >&2
  exit 1
fi

bad_pdfs=$(printf '%s\n' "$staged" | grep -Ei '\.pdf$' | grep -Ev '^tests/fixtures/' || true)
if [ -n "$bad_pdfs" ]; then
  echo "pre-commit: PDFs may only be committed under tests/fixtures/:" >&2
  printf '  %s\n' $bad_pdfs >&2
  exit 1
fi
