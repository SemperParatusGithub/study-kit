#!/bin/sh
# Enforce Conventional Commits v1.0.0 and forbid co-author trailers.
# https://www.conventionalcommits.org/en/v1.0.0/
set -eu

msg_file="$1"
# Ignore comment lines that git strips anyway.
msg=$(grep -v '^#' "$msg_file" || true)
subject=$(printf '%s\n' "$msg" | sed -n '1p')

# Applies to every commit, including the git-generated subjects exempted below.
if printf '%s\n' "$msg" | grep -Eiq '^co-authored-by:'; then
  echo "commit-msg: Co-Authored-By trailers are not allowed in this repository" >&2
  exit 1
fi

# Subjects git writes itself are exempt from the Conventional Commit format only. A
# "Merge …" subject only on a merge git is making (MERGE_HEAD exists while the hook runs);
# on any other commit it is hand-written and gets checked.
case "$subject" in
  "Merge "*)
    if [ -f "$(git rev-parse --git-path MERGE_HEAD 2>/dev/null)" ]; then
      exit 0
    fi
    ;;
  "Revert \""*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
if ! printf '%s\n' "$subject" | grep -Eq "^($types)(\([a-z0-9._/-]+\))?!?: [^ ].*$"; then
  echo "commit-msg: subject is not a Conventional Commit:" >&2
  echo "  $subject" >&2
  echo "expected: <type>(<optional scope>): <description>  with type in {$types}" >&2
  exit 1
fi

if [ "${#subject}" -gt 100 ]; then
  echo "commit-msg: subject is longer than 100 characters" >&2
  exit 1
fi
